# ============================================
# SMART PORTS v0.7
# MODO CLOUD
# ============================================

NODE_ENV=production

# Copia aquí la cadena PostgreSQL del proveedor cloud.
# Ejemplo de formato:
# postgresql://USUARIO:CLAVE@HOST:5432/postgres
DATABASE_URL=PEGAR_AQUI_LA_CONNECTION_STRING

# En PostgreSQL administrado normalmente se requiere SSL.
DB_SSL=true
DB_POOL_MAX=10

# Genera una clave larga y secreta.
JWT_SECRET=CAMBIA_ESTA_CLAVE_POR_UNA_LARGA_Y_ALEATORIA

# Cuenta inicial del sistema.
INITIAL_ADMIN_EMAIL=admin@smartports.com
INITIAL_ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE

# true mantiene los datos de demostración cuando la BD está vacía.
SEED_DEMO_DATA=true

# Render asigna PORT automáticamente. No hace falta definirlo en producción.
# PUBLIC_URL se puede definir después de conocer la URL publicada.
PUBLIC_URL=
